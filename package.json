{
  "name": "cv-screening-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@sap/cds": "^9",
    "@cap-js/sqlite": "^2.4",
    "axios": "^1.17.0",
    "groq-sdk": "^1.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-parse": "1.1.1",
    "dotenv": "^16.0.0",
    "@sap/xssec": "^3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "kind": "dummy"
      }
    },
    "features": {
      "draft_compat": false
    }
  }
}